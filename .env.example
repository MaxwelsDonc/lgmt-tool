# LGMT environment variables. Copy to .env and fill in, or export directly.
# The tool itself reads the environment; use `direnv` or `source .env` as you prefer.

# API key for the OpenAI-compatible endpoint (overrides config file).
LGMT_API_KEY=

# Base URL of the OpenAI-compatible endpoint (overrides config file).
LGMT_BASE_URL=

# Default model name (overrides config file).
LGMT_MODEL=
